# Copy to .env and change what you need. Every setting has a default.

# Folder with the documents the helper may search (mounted read-only).
# Use a full path, e.g. /Users/essam/Documents/Notes
DOCS_FOLDER=./docs

# Chat model shown first in the picker, and the embedding model for document search.
DEFAULT_MODEL=qwen3:8b
EMBED_MODEL=qwen3-embedding:0.6b

# Context window (tokens) and number of document excerpts per question.
NUM_CTX=8192
TOP_K=5

# OLLAMA_BASE_URL=http://host.docker.internal:11434
# APP_PORT=7860
